<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="referrer" content="strict-origin-when-cross-origin">
<title>Video Portfolio - Daniel Rudenberg</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;800&family=Wix+Madefor+Display:wght@400;500&family=Wix+Madefor+Text:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#fafaf9;--fg:#5391d6;--mute:#5391d6;--line:#e4e4e1;--ph:#ececea;--acc:#111;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0c0c0c;--fg:#5391d6;--mute:#5391d6;--line:#242424;--ph:#161616;--acc:#f2f2f0;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0c0c0c;--fg:#5391d6;--mute:#5391d6;--line:#242424;--ph:#161616;--acc:#f2f2f0;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--fg);font-family:"Wix Madefor Text","Helvetica Neue",Helvetica,Arial,sans-serif;font-weight:400;line-height:1.5;-webkit-font-smoothing:antialiased;transition:background .3s,color .3s}
a{color:inherit;text-decoration-thickness:1px;text-underline-offset:3px}
.bar{position:fixed;top:0;left:0;right:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:calc(14px + env(safe-area-inset-top,0px)) 24px 14px;background:color-mix(in srgb,var(--bg) 80%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
.brand{font-family:"Montserrat","Helvetica Neue",Arial,sans-serif;font-size:.85rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--mute)}
.toggle{display:flex;align-items:center;gap:8px;background:none;border:1px solid var(--line);color:var(--fg);border-radius:999px;padding:6px 12px 6px 8px;font:inherit;font-size:.78rem;cursor:pointer;transition:border-color .2s}
.toggle:hover{border-color:var(--mute)}
.toggle svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.toggle .moon{display:none}
:root[data-theme="dark"] .toggle .sun{display:none}
:root[data-theme="dark"] .toggle .moon{display:block}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .toggle .sun{display:none}:root:not([data-theme="light"]) .toggle .moon{display:block}}
main{max-width:980px;margin:0 auto;padding:0 24px 96px}
.hero{padding:clamp(120px,22vh,200px) 0 56px}
.hero h1{font-family:"Montserrat","Helvetica Neue",Arial,sans-serif;font-size:clamp(2.1rem,8.2vw,5.6rem);font-weight:800;text-transform:uppercase;letter-spacing:.14em;line-height:1.05;margin:0 -.14em 0 0}
.hero p{margin:18px 0 0;color:var(--mute)}
.item{padding:120px 0 40px;border-top:1px solid var(--line)}
.media{position:relative;width:100%;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:var(--ph);display:grid;place-items:center}
.media.tall{aspect-ratio:9/16;max-width:360px}
.media iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.play{width:64px;height:64px;border-radius:50%;border:1px solid var(--mute);display:grid;place-items:center;color:var(--mute)}
.play svg{width:22px;height:22px;fill:currentColor;margin-left:3px}
.cap{margin-top:20px;max-width:640px}
.cap h2{font-family:"Wix Madefor Display","Wix Madefor Text",Arial,sans-serif;font-size:clamp(1.15rem,2.2vw,1.45rem);font-weight:400;line-height:1.3;letter-spacing:-.01em;margin:0}
.cap p{margin:6px 0 0;color:var(--mute);font-size:1rem}
.cap h2+p{margin-top:8px}
.cap.top{margin:0 0 24px}
.n{display:block;font-size:.72rem;letter-spacing:.14em;color:var(--mute);margin-bottom:10px;font-variant-numeric:tabular-nums}
.sec{padding:72px 0 8px;border-top:1px solid var(--line)}
.sec h2{font-family:"Montserrat","Helvetica Neue",Arial,sans-serif;font-size:clamp(1.3rem,3.6vw,2.2rem);font-weight:700;text-transform:uppercase;letter-spacing:.14em;margin:0}
.sec+.item{border-top:0;padding-top:48px}
footer{padding-top:24px;color:var(--mute);font-size:.8rem}
@media (max-width:700px){
 html{scroll-snap-type:y mandatory}
 .bar{padding-left:16px;padding-right:16px}
 main{padding:0 10px}
 .hero,.item,.sec{min-height:100svh;display:flex;flex-direction:column;justify-content:center;scroll-snap-align:center;scroll-snap-stop:always;padding:84px 0 40px;border-top:0}
 .item{padding:84px 18px 40px;margin:0 -2px}
 .item>*{width:100%}
 .item.card{background:none;border:0;border-radius:0;min-height:100svh;margin:0;padding:84px 0 40px;justify-content:center}
 .media.tall{max-width:none;aspect-ratio:9/14}
 footer{min-height:30svh;display:flex;align-items:end;scroll-snap-align:end}
}
.grp{display:grid;gap:16px}
.grp.g2{grid-template-columns:1fr}
.grp.g2.t{grid-template-columns:repeat(2,minmax(0,360px))}
.grp.g2 .media.tall{aspect-ratio:9/16;max-width:none}
@media (max-width:700px){.grp.g2,.grp.g2.t{display:flex;grid-template-columns:none;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 10px;margin:0 -10px;padding:0 10px;width:calc(100% + 20px);scrollbar-width:none;-webkit-overflow-scrolling:touch}.grp.g2::-webkit-scrollbar{display:none}.grp.g2 .media{flex:0 0 94%;scroll-snap-align:start}.grp.g2.t .media{flex:0 0 80%}.grp.g2 .media:last-child{margin-right:10px}.cap{padding:0 6px}.nav{display:flex;justify-content:flex-end;gap:12px;margin-top:20px}}
.nav{display:none}
.nav button{width:44px;height:44px;border-radius:50%;border:0;background:color-mix(in srgb,var(--fg) 14%,transparent);color:var(--fg);display:grid;place-items:center;cursor:pointer;padding:0}
.nav svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</head>
<body>
<header class="bar">
  <span class="brand">Daniel Rudenberg</span>
  <button class="toggle" id="t" aria-label="Switch between light and dark mode">
    <svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    <svg class="moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    <span id="tl">Light</span>
  </button>
</header>
<main>
  <section class="hero"><h1>Video Portfolio</h1></section>
  <div id="list"></div>
  <footer>Daniel Rudenberg</footer>
</main>
<script>
/* Paste each video's embed URL (e.g. https://www.youtube.com/embed/ID) into "embed". Empty = placeholder. */
var Y="https://www.youtube.com/embed/";
var V=[
 {t:"I edited this video for a US county-level political campaign (I didn’t create the “delmarva power” animation)",embeds:[Y+"3HYC01RXluA"]},
 {t:"Ottawa Symphony Orchestra Promotional Video",embeds:[Y+"ZPpf5sn-wcg"]}
];
var h="",n=0,PL='<svg viewBox="0 0 24 24"><path d="M6 4l14 8-14 8z"/></svg>';
V.forEach(function(v){
 if(v.sec){h+='<div class="sec"><h2>'+v.sec+'</h2></div>';return}
 n++;
 var E=v.embeds||[],m='<div class="grp g'+E.length+(v.tall?' t':'')+'">'+E.map(function(u,i){return '<div class="media'+(v.tall?' tall':'')+'"><iframe src="'+u+'" title="Video '+n+(E.length>1?'.'+(i+1):'')+'" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen allow="accelerometer; encrypted-media; picture-in-picture; fullscreen"></iframe></div>'}).join('')+'</div>'+(E.length>1?'<div class="nav"><button class="pv" aria-label="Previous video"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button><button class="nx" aria-label="Next video"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button></div>':'');
 h+='<article class="item card">'+(v.top?'':m)+'<div class="cap'+(v.top?' top':'')+'">'+(v.t?'<h2>'+v.t+'</h2>':'')+(v.d?'<p>'+v.d+'</p>':'')+'</div>'+(v.top?m:'')+'</article>';
});
document.getElementById("list").innerHTML=h;
document.querySelectorAll(".nav button").forEach(function(b){b.onclick=function(){var g=b.closest(".item").querySelector(".grp");g.scrollBy({left:(b.classList.contains("nx")?1:-1)*g.clientWidth*.8,behavior:"smooth"})}});
var r=document.documentElement,b=document.getElementById("t"),l=document.getElementById("tl");
function cur(){var a=r.getAttribute("data-theme");return a||(matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light")}
function lab(){l.textContent=cur()==="dark"?"Dark":"Light"}
try{var s=localStorage.getItem("theme");if(s)r.setAttribute("data-theme",s)}catch(e){}
lab();
b.onclick=function(){var x=cur()==="dark"?"light":"dark";r.setAttribute("data-theme",x);try{localStorage.setItem("theme",x)}catch(e){}lab()};
</script>
</body>
</html>
